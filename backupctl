#!/usr/bin/env bash
# Installed entry point. A source checkout runs the Cargo binary instead.
set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$HERE/Cargo.toml" ]]; then
  if [[ -x "$HERE/target/release/backupctl" && ! -L "$HERE/target/release/backupctl" ]]; then
    exec "$HERE/target/release/backupctl" "$@"
  fi
  if [[ -x "$HERE/target/debug/backupctl" && ! -L "$HERE/target/debug/backupctl" ]]; then
    exec "$HERE/target/debug/backupctl" "$@"
  fi
  printf 'ERROR: build backupctl first: cargo build --release -p backupctl\n' >&2
  exit 1
fi

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

protected_regular() {
  local path=$1 owner mode euid
  [[ -f "$path" && ! -L "$path" ]] || return 1
  owner="$(stat -c %u -- "$path")"
  mode="$(stat -c %a -- "$path")"
  euid="$(id -u)"
  [[ "$owner" == 0 || "$owner" == "$euid" ]] || return 1
  (( (8#$mode & 8#022) == 0 ))
}

LIB_ROOT=/usr/local/lib/homelab-backup
RELEASES_ROOT="$LIB_ROOT/releases"
CURRENT_ROOT="$LIB_ROOT/current"
if [[ -n "${HOMELAB_BACKUP_RELEASE_ROOT:-}" ]]; then
  release_root="$(readlink -f -- "$HOMELAB_BACKUP_RELEASE_ROOT")"
else
  release_root="$(readlink -f -- "$CURRENT_ROOT")" ||
    die "installed current release is invalid: $CURRENT_ROOT"
  export HOMELAB_BACKUP_RELEASE_ROOT="$release_root"
fi
release_name="$(basename -- "$release_root")"
if [[ "$(dirname -- "$release_root")" != "$RELEASES_ROOT" ||
      ! "$release_name" =~ ^release\.[A-Za-z0-9]+$ ||
      ! -d "$release_root" || -L "$release_root" ]]; then
  die "installed release is outside the release store: $release_root"
fi
lease="$release_root/.lease"
protected_regular "$lease" ||
  die "installed release lease is invalid: $lease: lease is not a protected regular file"
binary="$release_root/bin/backupctl"
[[ -x "$binary" && ! -L "$binary" ]] ||
  die "installed application is missing: $binary"

helper_file="$release_root/volume-helper-image"
protected_regular "$helper_file" ||
  die "installed helper image metadata is invalid: $helper_file"
helper_line="$(sed -n '1p' -- "$helper_file")"
if [[ "$helper_line" == \{* &&
      "$helper_line" =~ \"tag\":\"(homelab/volume-rsync:release\.[A-Za-z0-9]+)\" ]]; then
  export HOMELAB_BACKUP_RELEASE_VOLUME_HELPER_IMAGE="${BASH_REMATCH[1]}"
else
  die "installed helper image metadata is invalid: $helper_file"
fi
dockerfile="$release_root/Dockerfile.volume-rsync"
if [[ -f "$dockerfile" && ! -L "$dockerfile" ]]; then
  export HOMELAB_BACKUP_RELEASE_VOLUME_HELPER_DOCKERFILE="$dockerfile"
fi

exec flock -s -- "$lease" "$binary" "$@"
