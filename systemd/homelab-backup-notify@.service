[Unit]
Description=Send homelab-backup failure notification for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Always logs an ALERT line to the journal; additionally pushes to the URL in
# alert.notify_url_file (ntfy or healthchecks) when one is configured.
ExecStart=/usr/local/sbin/backupctl notify-failure %i
