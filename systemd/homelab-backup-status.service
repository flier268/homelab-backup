[Unit]
Description=Alert when homelab backups have not succeeded recently
After=network-online.target
Wants=network-online.target
OnFailure=homelab-backup-notify@%n.service

[Service]
Type=oneshot
TimeoutStartSec=15min
# Exits 2 when a scheduled service is stale or the global lock has been held
# longer than alert.max_lock_age; OnFailure= then notifies.
ExecStart=/usr/local/sbin/backupctl status
