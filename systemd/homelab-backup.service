[Unit]
Description=Evaluate and run due homelab backups
After=docker.service network-online.target
Wants=network-online.target
OnFailure=homelab-backup-notify@%n.service

[Service]
Type=oneshot
# A timeout counts as failure, so a hung run still triggers OnFailure=.
TimeoutStartSec=6h
ExecStart=/usr/local/sbin/backupctl run-due
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
